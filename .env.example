# Copy this file to .env and adjust as needed. None of these are required to
# run the server locally — every one has a safe default for development.

# Standard Node environment flag. Setting this to "production" tightens two
# behaviors below (ALLOW_INLINE_CONFIGS, ADMIN_API_KEY) — see each for details.
NODE_ENV=development

# Directory holding website config JSON files (id.json). Relative paths
# resolve against the process's working directory.
# Default: configs/websites
CONFIGS_DIR=configs/websites

# Bearer token required for POST/PUT/DELETE /websites (GET routes and /scrape
# stay open regardless). Compared with a constant-time check.
#   - set:              writes require "Authorization: Bearer <this value>"
#   - unset, dev:        writes allowed unauthenticated (a startup warning is logged)
#   - unset, production: writes disabled entirely (403 FORBIDDEN)
# Default: unset
ADMIN_API_KEY=

# Whether flat ({url, selector, extract}) and inline-config ({url, config})
# /scrape requests are allowed, as opposed to only pre-saved {website: "<id>"}
# configs. Accepts "true" or "false"; unset defaults to true unless
# NODE_ENV=production.
# Default: true (false in production)
ALLOW_INLINE_CONFIGS=

# Allows the SSRF/private-network policy to permit loopback/private/
# link-local addresses. Only ever needed by the test suite, which runs its
# own fixture servers on 127.0.0.1. Must stay unset (or "false") on any
# server that's actually reachable by anyone else.
# Default: false
ALLOW_PRIVATE_NETWORKS=false

# Maximum size, in bytes, of a single scraped page's response. Static mode
# aborts a streaming download once this is exceeded (checking Content-Length
# first); browser mode checks the rendered page's size the same way.
# Default: 5242880 (5 MB)
MAX_RESPONSE_BYTES=5242880

# Where saved website configs live: "file" (configs/websites/<id>.json, the
# default) or "sqlite" (a local SQLite database via Node's built-in
# node:sqlite — still marked experimental by Node itself, hence the warning
# you'll see once at startup if you use this mode).
# Default: file
CONFIG_STORAGE=file

# Only used when CONFIG_STORAGE=sqlite. Path to the SQLite database file
# (created automatically, along with its parent directory, if missing).
# Default: data/configs.sqlite
DATABASE_PATH=data/configs.sqlite

# How "async": true scrape jobs are processed: "memory" (default — runs
# in-process, no setup needed) or "bullmq" (a real Redis-backed queue; the
# API process only enqueues, and a separate `npm run worker` process — or
# several, on the same or different machines — actually processes jobs).
# Default: memory
QUEUE_DRIVER=memory

# Only used when QUEUE_DRIVER=bullmq. Read by both the API process and
# `npm run worker` — they must point at the same Redis.
# Default: redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379
